# Copy to .env and fill in. Never commit .env.

# stdio mode only: your key from dining.iiit.ac.in -> Settings -> Auth Keys -> Create.
# (HTTP mode takes the key from each request's Authorization header instead.)
MESS_API_KEY=

# Base URL of the mess portal API. Only reachable from the IIITH network or VPN.
MESS_API_URL=https://mess.iiit.ac.in/api

# HTTP mode only.
HOST=127.0.0.1
PORT=3000
# Public hostname(s) clients use to reach this server, comma-separated, e.g. mess-mcp.example.com.
# Needed when running behind a tunnel or reverse proxy (Host header validation).
ALLOWED_HOSTS=
# Browser origins allowed to call /mcp, comma-separated. Leave empty unless a browser client needs it.
ALLOWED_ORIGINS=
