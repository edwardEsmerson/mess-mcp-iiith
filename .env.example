# Copy to .env and fill in. Never commit .env.

# --- stdio (local) mode ---
# Your key from dining.iiit.ac.in -> Settings -> Auth Keys -> Create.
MESS_API_KEY=

# Base URL of the mess portal API. Only reachable from the IIITH network or VPN.
MESS_API_URL=https://mess.iiit.ac.in/api

# --- HTTP (hosted, OAuth) mode ---
# Public https origin clients use, no path. The MCP endpoint is PUBLIC_URL/mcp.
# http://localhost:PORT is allowed for local testing only.
PUBLIC_URL=https://your-host.example.ts.net
# 32 random bytes, base64. Encrypts stored dining keys and signs sign-in pages.
# Generate with: openssl rand -base64 32. Losing it only forces users to reconnect.
MCP_SECRET=
HOST=127.0.0.1
PORT=3000
# Where the SQLite database goes. systemd's StateDirectory= overrides this.
DATA_DIR=./data
# Extra Host headers to accept, comma-separated (PUBLIC_URL's host, localhost and 127.0.0.1 are always allowed).
ALLOWED_HOSTS=
# Extra browser origins allowed to call the server, comma-separated. Usually empty.
ALLOWED_ORIGINS=
# Which proxies to trust for client IPs (rate limiting). Express "trust proxy" syntax.
TRUST_PROXY=loopback
# Secret shared with the Cloudflare Worker (deploy/cloudflare-worker). When set, rate limits use the visitor's address
# from the X-Mess-Client-IP header, but only on requests whose X-Mess-Proxy-Secret header equals this. Without it, everyone
# behind the Worker looks like one Cloudflare address and shares one limit. At least 20 characters, no spaces.
# Generate with: openssl rand -hex 32. Give the Worker the same value: npx wrangler secret put PROXY_SECRET
PROXY_SECRET=
# Turns on the usage dashboard (PUBLIC_URL/dashboard) and Prometheus metrics (/metrics). Leave empty to record nothing.
# Pick any password, at least 10 characters. You type it on the dashboard's sign-in page; scrapers send it as a bearer token.
DASHBOARD_PASSWORD=
# Shown on the public /privacy page under "How this server is hosted", so users know who can see their traffic.
# Plain text (HTML is escaped), e.g. "Runs on the maintainer's laptop on the IIITH campus, behind Cloudflare."
# Say it if a proxy like Cloudflare sits in front: it can read the dining keys users paste. Leave empty to show nothing.
HOSTING_NOTE=
