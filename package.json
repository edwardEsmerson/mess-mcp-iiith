{
  "name": "mess-mcp-iiith",
  "version": "0.3.0",
  "description": "MCP server for the IIIT Hyderabad dining portal: menus, registrations, cancellations, extras and bills from any MCP client",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Ayaansh <solankiayaansh@gmail.com>",
  "bin": {
    "mess-mcp-iiith": "dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "count-tokens": "npm run build && node scripts/count-tool-tokens.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
